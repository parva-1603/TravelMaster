generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Package {
  id         Int     @id @default(autoincrement())
  title      String
  location   String
  price      String
  rating     String
  duration   String
  image      String
  isTrending Boolean @default(false)
}

model Location {
  id      Int    @id @default(autoincrement())
  name    String
  state   String
}
